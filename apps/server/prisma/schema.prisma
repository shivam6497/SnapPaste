generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Paste {
  id            String    @id @default(cuid())
  code          String    @unique
  title         String?
  content       String
  language      String?
  expiresAt     DateTime?
  burnAfterRead Boolean   @default(false)
  password      String?
  createdAt     DateTime  @default(now())

  @@index([expiresAt])
}